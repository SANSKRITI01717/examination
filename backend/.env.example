# Examination OSM AI - Backend Environment Variables

# Database: PostgreSQL (with psycopg v3 sync driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/examination_osm

# Auth & Security
JWT_SECRET=change_this_to_a_secure_random_key_in_production
JWT_EXPIRE_MINUTES=480

# CORS Origins (comma-separated or list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Storage (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_ENDPOINT=
S3_KEY=
S3_SECRET=

# OCR Provider (default: Google Cloud Vision)
OCR_PROVIDER=vision
GOOGLE_APPLICATION_CREDENTIALS=

# LLM Provider (anthropic or gemini)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Embedding Provider & Pinecone Vector Store (Optional RAG)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=exam-references

# Limits & Concurrency
MAX_UPLOAD_MB=15
JOB_WORKERS=4
